[Unit]
Description=MusicPractice Django app
After=network.target

[Service]
User=musicpractice
Group=musicpractice
WorkingDirectory=/home/musicpractice/musicpractice
EnvironmentFile=/home/musicpractice/data/musicpractice.env
ExecStart=/home/musicpractice/data/venv/bin/gunicorn config.wsgi:application --workers 1 --threads 4 --timeout 0 --bind 127.0.0.1:8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
